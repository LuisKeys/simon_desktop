{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Simon Desktop (Go/Wails)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "preLaunchTask": "clean-debug-bin",
      "program": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "buildFlags": "-tags dev",
      "env": {
        "CGO_LDFLAGS": "-framework UniformTypeIdentifiers"
      }
    }
  ]
}
